[Unit]
Description=LLM Control - Inference Manager and Web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.llmcontrol
ExecStart=%h/go/bin/llmctl daemon -config %h/.llmcontrol/config.json
Restart=on-failure
RestartSec=3s
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
