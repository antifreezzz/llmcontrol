[Unit]
Description=ESP32 Desk Display Telemetry and LLM Bridge
After=network.target llmcontrol.service

[Service]
Type=simple
WorkingDirectory=%h/pc-telemetry-dashboard
ExecStart=/usr/bin/python3 %h/pc-telemetry-dashboard/host/host.py
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
